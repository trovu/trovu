#!/bin/bash

# Trovu CLI command utility
# Usage: trov <command> [args]
# Self-contained - does not depend on PATH

# Ensure ~/bin is in PATH for this script's execution
export PATH="$HOME/bin:$PATH"

TROVU_DIR="/home/ML/trovu"
PID_FILE="/tmp/trovu-dev-server.pid"

trov() {
  local command="$1"
  local args=("$@")
  unset 'args[0]'  # remove command name

  case "$command" in
    start)
      echo "🚀 Starting Trovu development server..."
      echo "   Loading from: $TROVU_DIR"
      # Start dev server (from package.json: npm run dev-server)
      cd "$TROVU_DIR" && npm run dev-server > /dev/null 2>&1 &
      local pid=$!
      echo $pid > "$PID_FILE"
      sleep 2
      echo "✅ Server started (PID: $pid)"
      ;;

    stop)
      echo "🛑 Stopping Trovu development server..."
      # Kill by PID file first
      if [ -f "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null && echo "✅ Server stopped (via PID file)" || echo "⚠️ PID file exists but process not found"
        rm -f "$PID_FILE"
      else
        # Fallback: kill by pattern
        pkill -f "serve.*dist/public.*8081" 2>/dev/null && echo "✅ Server stopped (via pattern)" || echo "⚠️ No running process found"
      fi
      ;;

    restart)
      echo "♻️ Restarting Trovu development server..."
      trov stop
      sleep 2  # Wait for ports to release
      trov start
      ;;

    status)
      echo "🔍 Checking Trovu status..."
      local running=false
      if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        running=true
      elif pgrep -f "serve.*dist/public.*8081" > /dev/null; then
        running=true
      fi

      if [ "$running" = true ]; then
        echo "✅ Server is running (port 8081)"
        if curl -s http://127.0.0.1:8081 > /dev/null; then
          echo "🌐 Server is responding on http://127.0.0.1:8081"
        else
          echo "⚠️ Server running but may not be responding"
        fi
      else
        echo "❌ Server is not running"
        echo "Run 'trov start' to start it"
      fi
      ;;

    logs)
      echo "📜 Showing Trovu server logs..."
      echo "Live server logs (Ctrl+C to exit):"
      echo "Use: journalctl -u trov-dev -f  (if running as service)"
      echo "Or check: tail -f $TROVU_DIR/*.log 2>/dev/null"
      ;;

    *)
      echo "❓ Unknown command: $command"
      echo "Available commands: start, restart, stop, status, logs"
      echo "Example: trov status"
      return 1
      ;;
  esac
}

# Execute command if provided
if [ $# -eq 0 ]; then
  echo "Usage: trov <command> [args]"
  echo "Commands: start, restart, stop, status, logs"
else
  trov "$@"
fi